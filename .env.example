# Local development: a plain SQLite file. Zero config.
DATABASE_URL=file:local.db

# Production on Vercel: create a free Turso database (https://turso.tech),
# then set these two instead:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_AUTH_TOKEN=

# City financial databases. These are independent from DATABASE_URL and from
# each other. Local defaults are separate files; production should point each
# variable at its own Turso database.
CITY_DB_BERKELEY_URL=file:city-berkeley.db
CITY_DB_MEXICO_CITY_URL=file:city-mexico-city.db
# CITY_DB_BERKELEY_AUTH_TOKEN=
# CITY_DB_MEXICO_CITY_AUTH_TOKEN=

# Secret for signing session cookies. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=dev-secret-change-me-in-production

# Sandbox mode (default: true). Organizations are auto-approved at signup.
# Set to false to require admin review before orgs can publish.
SANDBOX_MODE=true

# Staged rollout. Default (unset) = everything on (full build visible in dev).
# Set PROGRAM_PHASE=volunteer-mgmt for the iteration-1 preset: hides civic
# credits, redeemers, and the catalog approval gate; keeps the Opportunity
# Catalog as a convenience (reusable templates). Per-capability overrides:
#   FEATURE_CREDITS / FEATURE_REDEEMERS / FEATURE_CATALOG / FEATURE_CATALOG_APPROVAL = true|false
# PROGRAM_PHASE=volunteer-mgmt

# Ledger anchoring mode:
#   stub = compute Merkle roots locally, no chain posting (pilot default)
#   base = post Merkle roots to Base (requires ANCHOR_RPC_URL + ANCHOR_PRIVATE_KEY; adapter stub included)
ANCHOR_MODE=stub

# Profile image storage:
#   local = write to /public/uploads, served from /uploads (dev default; not for Vercel)
#   blob  = Vercel Blob (set BLOB_READ_WRITE_TOKEN; recommended in production)
STORAGE_MODE=local
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Reminder email delivery:
#   stub   = log only, no email leaves the box (dev default)
#   resend = send via Resend (set RESEND_API_KEY + REMINDER_FROM)
REMINDER_EMAIL_MODE=stub
# RESEND_API_KEY=re_xxx
# REMINDER_FROM=City/Sync <noreply@your-domain.org>

# Public base URL, used to build absolute links in reminder emails.
# APP_URL=https://your-app.vercel.app

# Secret for the reminder cron endpoint. Vercel Cron sends it automatically as
# `Authorization: Bearer ${CRON_SECRET}`. If unset, /api/cron/reminders is open
# (fine for local dev).
# CRON_SECRET=generate-with-openssl-rand-hex-32
